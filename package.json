{
  "name": "s-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio website built with PHP and Tailwind CSS v4",
  "scripts": {
    "watch": "tailwindcss -i ./style/input.css -o ./style/output.css --watch",
    "build": "tailwindcss -i ./style/input.css -o ./style/output.css --minify",
    "serve": "php -S localhost:8000"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
